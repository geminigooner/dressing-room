{
  "name": "dressing-room",
  "main": "worker/index.js",
  "compatibility_date": "2026-08-20",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "dressing-room",
      "database_id": "fa70714f-58d5-49ae-a3f..."
    }
  ],
  "r2_buckets": [
    { "binding": "BUCKET", "bucket_name": "dressingroomstorage" }
  ]
}